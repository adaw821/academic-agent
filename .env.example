# Copy to .env in the project root. Never commit real credentials.
# Existing terminal environment variables take precedence. Restart after editing.
# Uncomment and fill these if they are not already set in your environment.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/DATABASE
# ZHIPU_API_KEY=your-model-api-key

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_FROM=
# QQ SMTP authorization code, not your QQ account password.
SMTP_PASSWORD=
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
EMAIL_CODE_SECRET=

# Desktop only; leave disabled on public servers.
ISPACE_LOCAL_LOGIN=0

# Absolute path to a base64-encoded 32-byte AES key OUTSIDE this repository.
# Keep this key stable, private, and backed up separately from the database.
SCHOOL_KEY_FILE=
